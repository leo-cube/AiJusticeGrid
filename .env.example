# Augment AI Configuration
# Set to 'true' to enable Augment AI features
NEXT_PUBLIC_ENABLE_AUGMENT_AI=true

# Augment AI API Key (replace with your actual key)
NEXT_PUBLIC_AUGMENT_AI_API_KEY=your-augment-ai-api-key-here

# Augment AI API Endpoint
NEXT_PUBLIC_AUGMENT_AI_ENDPOINT=/api/augment-ai

# NVIDIA API Configuration
# Replace with your actual NVIDIA API key
NEXT_PUBLIC_NVIDIA_API_KEY=your-nvidia-api-key-here

# Agent API URLs (default local development URLs)
NEXT_PUBLIC_MURDER_AGENT_API_URL=http://127.0.0.1:5000/api/augment/murder
NEXT_PUBLIC_THEFT_AGENT_API_URL=http://127.0.0.1:5001/api/augment/theft
NEXT_PUBLIC_FINANCIAL_FRAUD_AGENT_API_URL=http://127.0.0.1:5002/api/augment/financial-fraud
