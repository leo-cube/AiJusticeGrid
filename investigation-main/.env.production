# Production Environment Configuration
# This file is used specifically for production builds

# =============================================================================
# PRODUCTION BACKEND API CONFIGURATION
# =============================================================================
# Replace with your actual production backend server URL
NEXT_PUBLIC_API_BASE_URL=https://your-production-backend.com/api

# =============================================================================
# PRODUCTION AGENT API CONFIGURATION
# =============================================================================
# Production Agent URLs
NEXT_PUBLIC_MURDER_AGENT_API_URL=https://your-production-backend.com/api/augment/murder
NEXT_PUBLIC_THEFT_AGENT_API_URL=https://your-production-backend.com/api/augment/theft
NEXT_PUBLIC_FINANCIAL_FRAUD_AGENT_API_URL=https://your-production-backend.com/api/augment/financial-fraud
NEXT_PUBLIC_FINANCE_AGENT_API_URL=https://your-production-backend.com/api/augment/finance
NEXT_PUBLIC_UNIFIED_AGENT_SERVER_URL=https://your-production-backend.com

# =============================================================================
# PRODUCTION AI CONFIGURATION
# =============================================================================
NEXT_PUBLIC_ENABLE_AUGMENT_AI=true
NEXT_PUBLIC_AUGMENT_AI_API_KEY=your-production-augment-ai-api-key
NEXT_PUBLIC_AUGMENT_AI_ENDPOINT=/api/augment-ai
NEXT_PUBLIC_NVIDIA_API_KEY=your-production-nvidia-api-key

# =============================================================================
# COMMON DOCKER DEPLOYMENT EXAMPLES
# =============================================================================
# If using Docker Compose with service names:
# NEXT_PUBLIC_API_BASE_URL=http://backend:5000/api
# NEXT_PUBLIC_UNIFIED_AGENT_SERVER_URL=http://backend:5000

# If using Kubernetes with service discovery:
# NEXT_PUBLIC_API_BASE_URL=http://backend-service.default.svc.cluster.local:5000/api
# NEXT_PUBLIC_UNIFIED_AGENT_SERVER_URL=http://backend-service.default.svc.cluster.local:5000
