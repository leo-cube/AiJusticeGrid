# Production Environment Variables Template
# Copy this file to .env.production or use these variables in your hosting platform

# Augment AI Configuration
NEXT_PUBLIC_ENABLE_AUGMENT_AI=true
NEXT_PUBLIC_AUGMENT_AI_API_KEY=demo-key-for-build
NEXT_PUBLIC_AUGMENT_AI_ENDPOINT=/api/augment-ai

# NVIDIA API Configuration
NEXT_PUBLIC_NVIDIA_API_KEY=demo-key-for-build

# Production Backend API URLs (your deployed backend)
NEXT_PUBLIC_MURDER_AGENT_API_URL=https://aijusticegrid.onrender.com/api/augment/murder
NEXT_PUBLIC_THEFT_AGENT_API_URL=https://aijusticegrid.onrender.com/api/augment/theft
NEXT_PUBLIC_FINANCIAL_FRAUD_AGENT_API_URL=https://aijusticegrid.onrender.com/api/augment/financial-fraud

# NextAuth Configuration (update with your frontend URL)
NEXTAUTH_URL=https://aijusticegrid.netlify.app
NEXTAUTH_SECRET=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456

# Production Environment
NODE_ENV=production
