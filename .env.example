# AI Justice Grid - Environment Configuration Example
# Copy this file to .env and update with your actual values

# =============================================================================
# NVIDIA API CONFIGURATION
# =============================================================================
# Your NVIDIA API key for AI services
NVIDIA_API_KEY=your-nvidia-api-key-here

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
# Flask secret key for session management
FLASK_SECRET_KEY=your-flask-secret-key-here

# =============================================================================
# FRONTEND CONFIGURATION (for separate deployment)
# =============================================================================
# Backend API URLs - Update these with your actual backend server URLs
NEXT_PUBLIC_API_BASE_URL=https://your-backend-server.com/api
NEXT_PUBLIC_UNIFIED_AGENT_SERVER_URL=https://your-backend-server.com

# Agent-specific URLs
NEXT_PUBLIC_MURDER_AGENT_API_URL=https://your-backend-server.com/api/augment/murder
NEXT_PUBLIC_THEFT_AGENT_API_URL=https://your-backend-server.com/api/augment/theft
NEXT_PUBLIC_FINANCIAL_FRAUD_AGENT_API_URL=https://your-backend-server.com/api/augment/financial-fraud

# AI Configuration
NEXT_PUBLIC_NVIDIA_API_KEY=your-nvidia-api-key-here
NEXT_PUBLIC_ENABLE_AUGMENT_AI=true

# =============================================================================
# DOCKER DEPLOYMENT EXAMPLES
# =============================================================================
# For Docker Compose deployment (services communicate internally):
# NEXT_PUBLIC_API_BASE_URL=http://backend:5000/api
# NEXT_PUBLIC_UNIFIED_AGENT_SERVER_URL=http://backend:5000

# For separate server deployment:
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_UNIFIED_AGENT_SERVER_URL=https://api.yourdomain.com

# =============================================================================
# DEPLOYMENT INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Update NVIDIA_API_KEY with your actual key
# 3. Update backend URLs if deploying separately
# 4. For Docker: docker-compose up -d
# 5. For manual: Follow DEPLOYMENT_README.md instructions
